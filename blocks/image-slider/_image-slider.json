{
  "definitions": [
    {
      "title": "Image Slider",
      "id": "image-slider",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Image Slider",
              "model": "image-slider",
              "filter": "image-slider",
              "blockId": "id:"
            }
          }
        }
      }
    },
    {
      "title": "Image Slider Item",
      "id": "image-slider-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Image Slider Item",
              "model": "image-slider-item",
              "label": "New Slide",
              "imageAlt": "Slide image"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "image-slider",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "classes_orientation",
          "label": "Orientation",
          "description": "Direction the slider scrolls.",
          "options": [
            { "name": "Horizontal (default)", "value": "" },
            { "name": "Vertical", "value": "image-slider-vertical" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "classes_labelPosition",
          "label": "Label Position",
          "description": "Where overlay labels appear relative to each image.",
          "options": [
            { "name": "Below image (default)", "value": "image-slider-label-bottom" },
            { "name": "Above image", "value": "image-slider-label-top" },
            { "name": "Left of image", "value": "image-slider-label-left" },
            { "name": "Right of image", "value": "image-slider-label-right" },
            { "name": "Centered on image", "value": "image-slider-label-center" }
          ]
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_accessible",
          "label": "Accessible View",
          "description": "Enables an accessible text toggle button on the slider (.image-slider-accessible)."
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "imageHeight",
          "label": "Image Height (px)",
          "description": "Shared height applied to every slide image. Aspect ratio is preserved."
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "imageWidth",
          "label": "Image Width (px)",
          "description": "Shared width applied to every slide image."
        },
        {
          "...": "../../models/_common-properties.json#/common-prop"
        }
      ]
    },
    {
      "id": "image-slider-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false,
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "value": "",
          "label": "Image Alt Text",
          "description": "Required. Describes the image for screen readers."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "value": "",
          "label": "Overlay Label",
          "description": "Short label displayed on or near the image (e.g. \"Week 4\")."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "accessibleText",
          "value": "",
          "label": "Accessible Text",
          "description": "Full text description shown in the accessible view instead of the image."
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "image-slider",
      "components": ["image-slider-item"]
    }
  ]
}
