{
  "definitions": [
    {
      "title": "Info Tree",
      "id": "info-tree",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Info Tree",
              "model": "info-tree",
              "filter": "info-tree",
              "blockId": "id:"
            }
          }
        }
      }
    },
    {
      "title": "Info Tree Answer",
      "id": "info-tree-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Info Tree Answer",
              "model": "info-tree-item",
              "answerLabel": "Yes",
              "answerContent": ""
            }
          }
        }
      }
    },
    {
      "title": "Info Tree CTA",
      "id": "info-tree-cta",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Info Tree CTA",
              "model": "info-tree-cta",
              "ctaLabel": "Button",
              "ctaHref": ""
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "info-tree",
      "fields": [
        {
          "component": "tab",
          "label": "Overview",
          "name": "overview"
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Side Image",
          "multi": false,
          "description": "Optional image displayed beside the question (e.g. Quick Poll badge)."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "value": "",
          "label": "Image Alt Text"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "heading",
          "value": "",
          "label": "Heading",
          "description": "Optional heading above the question."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "question",
          "value": "",
          "label": "Question",
          "description": "The question or prompt shown to the visitor."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "disclaimer",
          "value": "",
          "label": "Disclaimer",
          "description": "Optional footnote or trademark text shown below the answer buttons."
        },
        {
          "component": "tab",
          "label": "Settings",
          "name": "settings"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "classes",
          "label": "Layout",
          "options": [
            { "name": "Stacked (default)", "value": "" },
            { "name": "Inline (side by side)", "value": "inline" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "cookieName",
          "value": "",
          "label": "Cookie Name",
          "description": "Unique name for the browser cookie that persists the user's answer. No spaces or special characters."
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "showReset",
          "value": false,
          "label": "Show Reset Button",
          "description": "When enabled, a reset button lets the user clear their answer and choose again."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "resetLabel",
          "value": "Start over",
          "label": "Reset Button Label",
          "condition": {
            "===": [{ "var": "showReset" }, true]
          }
        },
        {
          "...": "../../models/_common-properties.json#/common-prop"
        }
      ]
    },
    {
      "id": "info-tree-item",
      "fields": [
        {
          "component": "tab",
          "label": "Answer",
          "name": "answer"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "answerLabel",
          "value": "",
          "label": "Answer Button Label",
          "description": "Text shown on the option button."
        },
        {
          "component": "richtext",
          "name": "answerContent",
          "value": "",
          "label": "Answer Content",
          "description": "Rich text content revealed when this answer option is selected.",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "info-tree-cta",
      "fields": [
        {
          "component": "tab",
          "label": "Button",
          "name": "button"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ctaLabel",
          "value": "Button",
          "label": "Button Text"
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "ctaHref",
          "label": "Button Link"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "ctaVariant",
          "label": "Button Style",
          "options": [
            { "name": "Primary", "value": "abbv-button-primary" },
            { "name": "Secondary", "value": "abbv-button-secondary" },
            { "name": "Tertiary", "value": "abbv-button-tertiary" }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "info-tree",
      "components": ["info-tree-item", "info-tree-cta"]
    }
  ]
}
