            "div.container.parbase:nth-of-type(6) .abbv-container"
          ]
        },
        {
          "name": "safety-bar",
          "instances": [
            "div.abbv-inline-use-isi",
            "div.abbv-fixed-isi"
          ],
          "section": "split"
